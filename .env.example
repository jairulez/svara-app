# SVARA environment — copy to .env (never commit .env)
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# SQLite file for the preview. Swap db adapter for PostgreSQL in production (see docs).
DATABASE_PATH=./data/svara.db

# Required in production: long random string used to HMAC session tokens + field encryption key derivation.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=change-me-in-production

# Demo mode: enables "Explore Svara" one-click demo personas and seeded demo data. Disable in real production.
DEMO_MODE=true

# Commerce gate. When true, ONLY products with regulatory_status=APPROVED and a licence_reference are listed.
COMMERCE_ENABLED=false

# Optional LLM (preview works without it using the deterministic engine).
LLM_PROVIDER=none          # none | anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Rate limits (requests per window)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# OAuth / magic link placeholders (not enabled in preview)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_URL=
